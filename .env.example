# Copy this file to .env and fill it in. Never share .env or commit it.

# Bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=paste-your-token-here

# Your timezone and when the daily final results post goes out (24-hour clock)
TIMEZONE=America/New_York
RESULTS_TIME=00:00

# Put a warning reaction on scores that don't add up from the emoji row (true/false)
VERIFY_SCORES=true

# Where the scores database lives. Default: %LOCALAPPDATA%\krillionDbot\krillion.db (outside OneDrive)
# DB_PATH=
